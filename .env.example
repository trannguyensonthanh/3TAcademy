# ==============================================================================
# EduTech AI Platform - Root Environment Variables Template
# ==============================================================================

# Database (PostgreSQL 16 with pgvector)
POSTGRES_DB=edutech_db
POSTGRES_USER=edutech_user
POSTGRES_PASSWORD=edutech_secret_2026
POSTGRES_PORT=5432

# Redis 7
REDIS_PASSWORD=redis_secret_2026
REDIS_PORT=6379

# Service Communication & Security
INTERNAL_API_KEY=internal_shared_secret_2026_change_in_production
JWT_ACCESS_SECRET=jwt_access_super_secret_key_2026_dev_minimum_32_chars
JWT_REFRESH_SECRET=jwt_refresh_super_secret_key_2026_dev_minimum_32_chars
COOKIE_SECRET=cookie_secret_key_2026

# Google OAuth 2.0 (1-Tap & Web login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Providers & Observability
GEMINI_API_KEY=your_gemini_api_key
VLLM_API_BASE=http://vllm-server:8000/v1
VLLM_API_KEY=vllm_internal_token
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# LiveKit WebRTC
LIVEKIT_API_URL=https://livekit.yourdomain.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Cloudflare R2 / S3 Storage (Video HLS & Materials)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=edutech-storage
R2_PUBLIC_DOMAIN=https://media.yourdomain.com
HLS_AES_GLOBAL_SALT=your_hls_aes_salt_key

# VNPay Payment Gateway
VNPAY_TMN_CODE=TESTCODE
VNPAY_HASH_SECRET=SECRETKEYTEST
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/result
