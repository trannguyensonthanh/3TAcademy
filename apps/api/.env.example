NODE_ENV=development
PORT=4000

# PostgreSQL 16 + pgvector (Docker dev default port: 54320)
POSTGRES_DB=edutech_db
POSTGRES_USER=edutech_user
POSTGRES_PASSWORD=edutech_secret_2026
POSTGRES_PORT=54320
DATABASE_URL=postgres://edutech_user:edutech_secret_2026@localhost:54320/edutech_db

# Redis 7
REDIS_PASSWORD=redis_secret_2026
REDIS_PORT=6379
REDIS_URL=redis://:redis_secret_2026@localhost:6379

# Auth & Cryptographic Secrets (minimum 32 chars for JWT secrets)
INTERNAL_API_KEY=internal_shared_secret_2026
JWT_ACCESS_SECRET=jwt_access_super_secret_key_2026_dev
JWT_REFRESH_SECRET=jwt_refresh_super_secret_key_2026_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
HMAC_CERTIFICATE_SECRET=3t-academy-hmac-certificate-secret-key-2026

# Google OAuth (optional in local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Microservice & Gemini Fallback
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SePay VietQR Reconciliation
PUBLIC_API_URL=http://localhost:4000
