# ==============================================================================
# Gitignore for 3T Academy / EduTech AI Platform Monorepo
# Architecture: Node.js (Express/TS) + React (Vite/TS) + Python (FastAPI/AI)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------------------------------------------
# Logs & Process Monitoring
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pip-log.txt

# ------------------------------------------------------------------------------
# Build Outputs & Compilation Caches (Node / TypeScript / Vite / Next.js)
# ------------------------------------------------------------------------------
dist/
**/dist/
dist-ssr/
build/
**/build/
out/
.next/
.turbo/
.vite/
.vite-temp/
**/.vite/
**/.vite-temp/
*.tsbuildinfo
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache/

# ------------------------------------------------------------------------------
# Python & AI Microservice (apps/ai-service)
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll
.Python

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.conda/
conda/
miniconda*/

# Python Packaging & Distribution
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/

# Python Testing & Type Checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# Heavy AI Model Weights, Checkpoints & Datasets (CRITICAL: NEVER COMMIT TO GIT)
# ------------------------------------------------------------------------------
# Preserve model directories with .gitkeep / README.md, but ignore all weight files
apps/ai-service/models/**
!apps/ai-service/models/**/
!apps/ai-service/models/**/.gitkeep
!apps/ai-service/models/**/README.md

apps/ai-service/models_onnx/**
!apps/ai-service/models_onnx/**/
!apps/ai-service/models_onnx/**/.gitkeep

# Binary & Serialized Weight Formats across the entire monorepo
*.onnx
*.bin
*.pt
*.pth
*.safetensors
*.ckpt
*.h5
*.hdf5
*.pb
*.tflite
*.engine
*.npy
*.npz

# HuggingFace & FastEmbed local download caches
huggingface/
.cache/
**/.cache/
*.part
*.crdownload

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.local
!.env.example
!**/.env.example

# Cryptographic Keys & Service Accounts
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
*serviceAccountKey*.json
*firebase-adminsdk*.json

# ------------------------------------------------------------------------------
# Media, User Uploads, Proctoring Snapshots & Recordings
# ------------------------------------------------------------------------------
uploads/
**/uploads/
storage/
**/storage/
tmp/
temp/
*.tmp

# Proctoring camera captures & session recordings
proctoring_captures/
proctoring_snapshots/
exam_snapshots/
recordings/
temp_audio/
temp_video/

# Large media binary files (raw recordings, video dumps)
*.mov
*.avi
*.mkv
*.flv
*.wmv
*.webm
*.m4v
*.mp4
*.wav
*.flac

# Whitelist official curriculum sample lecture videos and assets
!apps/web/public/videos/lectures/*.mp4
!apps/web/public/videos/lectures/*.vtt
!apps/web/public/videos/lectures/manifest.json

# ------------------------------------------------------------------------------
# Databases, Local Docker Volumes & Dumps
# ------------------------------------------------------------------------------
*.dump
*.sql.bak
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
postgres_data/
pgdata/
redis_data/
docker-compose.override.yml
*.override.yml

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Testing, Coverage & Browser Reports
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/
lcov.info

# ------------------------------------------------------------------------------
# AI Agent Workspaces & Temporary Tool Caches
# ------------------------------------------------------------------------------
.aistudio/
**/.aistudio/
.gemini/
.antigravity/
